# LLM UI Configuration Standards

This document outlines the standardized patterns for implementing LLM API key configuration UI across all demo pages in the Aevatar Workshop project.

## 📋 Core Requirements

### 1. **Mandatory API Usage**
All demo pages **MUST** use the following API endpoints for LLM configuration:

```javascript
// For listing available LLM systems
GET /api/llm-configs/list

// For full configuration management (admin features)
GET /api/llm-configs
POST /api/llm-configs
```

**❌ NEVER hardcode LLM options** - always fetch dynamically from the API.

## 🎨 UI Pattern Categories

### **Category A: Full Configuration Interface (Recommended for Complex Demos)**

**Usage:** Smart Home Demo, Theory Reasoning Demo

**Features:**
- ✅ Real-time LLM configuration status monitoring
- ✅ Configuration alert notifications
- ✅ Multi-language support
- ✅ Automatic configuration change detection
- ✅ Fallback and error handling
- ✅ Configuration guidance for users

**Implementation Pattern:**

```html
<!-- LLM Configuration Alert -->
<div id="llmConfigAlert" class="llm-config-alert" style="display: none;">
    <div style="display: flex; align-items: center; gap: 12px;">
        <div style="font-size: 24px;">⚠️</div>
        <div style="flex: 1;">
            <h4 data-i18n="llm_api_key_needed">LLM API Key Configuration Required</h4>
            <p data-i18n="llm_api_key_description">
                To experience AI features, please configure LLM API Key first.
            </p>
        </div>
        <button onclick="dismissLLMAlert()">✕</button>
    </div>
</div>

<!-- LLM Configuration Status -->
<div class="llm-config-status" id="llmConfigStatus">
    <div style="display: flex; align-items: center; gap: 8px;">
        <span id="llmStatusIcon">🔄</span>
        <span id="llmStatusText" data-i18n="llm_checking">Checking LLM configuration...</span>
    </div>
</div>

<!-- LLM Selector -->
<div class="llm-selector">
    <label for="systemLLM" data-i18n="ai_model">AI Model:</label>
    <select id="systemLLM">
        <option value="" data-i18n="loading">Loading...</option>
    </select>
    <button onclick="openLLMConfig()" data-i18n="config_llm">Configure LLM</button>
    <button onclick="reinitializeSystem()" data-i18n="reinitialize">Reinitialize</button>
</div>
```

**JavaScript Implementation:**

```javascript
// Status monitoring functions
function updateLLMConfigStatus(isConfigured, message) {
    const statusDiv = document.getElementById('llmConfigStatus');
    const iconSpan = document.getElementById('llmStatusIcon');
    const textSpan = document.getElementById('llmStatusText');
    
    if (isConfigured) {
        iconSpan.textContent = '✅';
        statusDiv.style.background = '#d1fae5';
        statusDiv.style.borderColor = '#10b981';
        textSpan.textContent = message || 'LLM configured successfully';
    } else {
        iconSpan.textContent = '❌';
        statusDiv.style.background = '#fee2e2';
        statusDiv.style.borderColor = '#ef4444';
        textSpan.textContent = message || 'LLM configuration needed';
    }
}

// Configuration change monitoring
function startLLMConfigWatcher() {
    if (llmConfigWatcher) {
        clearInterval(llmConfigWatcher);
    }
    
    llmConfigWatcher = setInterval(async () => {
        try {
            const response = await fetch('/api/llm-configs/list');
            const llmKeys = await response.json();
            const hasLLMConfig = llmKeys && llmKeys.length > 0;
            
            if (hasLLMConfig && (!lastLLMCheckResult || lastLLMCheckResult.length === 0)) {
                await loadAvailableLLMs();
                clearInterval(llmConfigWatcher);
                llmConfigWatcher = null;
            }
            lastLLMCheckResult = llmKeys;
        } catch (error) {
            console.error('LLM config watcher error:', error);
        }
    }, 2000);
}

function stopLLMConfigWatcher() {
    if (llmConfigWatcher) {
        clearInterval(llmConfigWatcher);
        llmConfigWatcher = null;
    }
}
```

### **Category B: Simple Configuration Interface (Recommended for Basic Demos)**

**Usage:** PSI GAgent Demo, Dynamic AI MCP Demo, Hybrid Python Demo

**Features:**
- ✅ Basic LLM selection dropdown
- ✅ Configuration button linking to admin interface
- ✅ Error handling and fallbacks
- ✅ Default selection (prefer DeepSeek)

**Implementation Pattern:**

```html
<!-- Simple LLM Configuration -->
<div class="control-group">
    <label for="llm-select">LLM Configuration:</label>
    <select id="llm-select">
        <option value="">Loading LLM configurations...</option>
    </select>
</div>

<div class="control-group">
    <button onclick="openLLMConfig()">Configure LLM</button>
    <button onclick="initializeAgent()">Initialize Agent</button>
</div>
```

**JavaScript Implementation:**

```javascript
async function loadAvailableLLMs() {
    try {
        const response = await fetch('/api/llm-configs/list');
        const llmConfigs = await response.json();
        
        const selectElement = document.getElementById('llm-select');
        selectElement.innerHTML = '';
        
        if (llmConfigs && llmConfigs.length > 0) {
            // ⚠️ IMPORTANT: /api/llm-configs/list returns an ARRAY of key names
            // NOT an object! e.g., ["AzureOpenAI", "Hyperecho"]
            const availableLLMs = Array.isArray(llmConfigs) ? llmConfigs : [llmConfigs];
            
            // Add default "None" option
            const defaultOption = document.createElement('option');
            defaultOption.value = '';
            defaultOption.textContent = 'None (Legacy mode only)';
            selectElement.appendChild(defaultOption);
            
            // Add LLM options
            availableLLMs.forEach(key => {
                const option = document.createElement('option');
                option.value = key;
                option.textContent = key;
                selectElement.appendChild(option);
            });
            
            // Set DeepSeek as default if available
            if (availableLLMs.includes('DeepSeek')) {
                selectElement.value = 'DeepSeek';
            } else if (availableLLMs.length > 0) {
                selectElement.value = availableLLMs[0];
            }
            
        } else {
            const noOption = document.createElement('option');
            noOption.value = '';
            noOption.textContent = 'No LLM configurations available';
            selectElement.appendChild(noOption);
        }

        // Add change event listener
        selectElement.addEventListener('change', (e) => {
            const selectedLLM = e.target.value;
            console.log(`Selected LLM: ${selectedLLM || 'None'}`);
            // Handle LLM selection change
        });

    } catch (error) {
        console.error('Failed to load LLM configurations:', error);
        const selectElement = document.getElementById('llm-select');
        selectElement.innerHTML = '<option value="">Error loading LLM configs</option>';
    }
}

// Global LLM configuration function
function openLLMConfig() {
    window.open('/', '_blank');
}
```

