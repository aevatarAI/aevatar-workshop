{
  "Serilog": {
    "Properties": {
      "Application": "Aevatar.Workshop.Host",
      "Environment": "Development"
    },
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Default": "Information",
        "System": "Warning",
        "Microsoft": "Warning",
        "Orleans": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "RollingFile",
        "Args": {
          "pathFormat": "Logs/log-{Date}.log",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff}{Offset:zzz}][{Level:u3}] [{SourceContext}] {Message}{NewLine}{Exception}",
          "rollOnFileSizeLimit": true,
          "rollingInterval": "Day",
          "retainedFileCountLimit": 15
        }
      }
    ]
  },
  "SystemLLMConfigs": {
    "DeepSeek": {
      "ProviderEnum": "DeepSeek",
      "ModelIdEnum": "DeepSeek",
      "ModelName": "deepseek-reasoner",
      "Endpoint": "https://api.deepseek.com",
      "ApiKey": "sk-5503ed6140844a8eb5d27615b47621cc"
    }
  },
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp", "/Users", "/System/Volumes/Data/Users"],
      "description": "Access and manage files in allowed directories",
      "icon": "📁"
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "description": "Manage knowledge graphs",
      "icon": "🧠"
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "description": "Break down complex problems step by step",
      "icon": "🤔"
    },
    "everything": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-everything"],
      "description": "Test server with various demo tools"
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "description": "General-purpose MCP server with database access, web search, text utilities, and more",
      "icon": "🌟"
    }
  }
}