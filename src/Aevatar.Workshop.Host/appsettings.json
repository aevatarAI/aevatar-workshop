      "ApiKey": "c44d9337-2c19-4880-8631-98bfa990d562",
      "ModelId": "OpenAI"
    },
    "DeepSeek": {
      "ProviderEnum": "DeepSeek",
      "ModelIdEnum": "DeepSeek",
      "ModelName": "deepseek-chat",
      "Endpoint": "https://api.deepseek.com",
      "ApiKey": "sk-600ab6738c0a4250b1b8dbb57f2fde1e"
    }
  }
}